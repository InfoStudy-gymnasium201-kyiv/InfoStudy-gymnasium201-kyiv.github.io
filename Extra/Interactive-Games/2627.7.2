<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Інфо-Лабораторія: Пошук та ШІ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            400: '#38bdf8',
                            500: '#0284c7',
                            600: '#0369a1',
                            900: '#0c4a6e',
                        },
                        violettech: '#6366f1',
                        emeraldtech: '#10b981',
                        ambertech: '#f59e0b',
                        darkbg: '#0f172a'
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            touch-action: manipulation;
            user-select: none;
            -webkit-user-select: none;
            background: #0f172a;
            color: #f8fafc;
        }

        /* Glassmorphism vector card style */
        .vector-card {
            background: rgba(30, 41, 59, 0.85);
            backdrop-filter: blur(12px);
            border: 2px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
        }

        .vector-btn {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 0 0 rgba(0,0,0,0.25);
        }

        .vector-btn:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 0 rgba(0,0,0,0.25);
        }

        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: #38bdf8;
            border-radius: 9999px;
        }

        .drag-item {
            touch-action: none;
            cursor: grab;
        }
        .drag-item:active {
            cursor: grabbing;
        }

        .drop-target-active {
            border-color: #38bdf8 !important;
            background-color: rgba(56, 189, 248, 0.15) !important;
            transform: scale(1.02);
        }

        @keyframes pulse-subtle {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(0.98); }
        }
        .animate-pulse-subtle {
            animation: pulse-subtle 3s infinite ease-in-out;
        }

        @keyframes float-vector {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
        }
        .animate-float {
            animation: float-vector 4s ease-in-out infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between overflow-x-hidden antialiased bg-slate-900 text-slate-100">

    <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-3">
        <div class="max-w-5xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/20 font-black text-xl text-white">
                    7
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-bold bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent leading-tight">
                        Інфо-Лабораторія
                    </h1>
                    <p class="text-xs text-slate-400 hidden sm:block">Пошук, Критичне мислення та ШІ</p>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="flex items-center space-x-2 sm:space-x-4">
                <div class="bg-slate-800/80 border border-slate-700/60 rounded-xl px-3 py-1.5 flex items-center space-x-2">
                    <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span id="score-display" class="font-bold text-amber-300 text-sm sm:text-base">0</span>
                </div>
                
                <div class="bg-slate-800/80 border border-slate-700/60 rounded-xl px-3 py-1.5 flex items-center space-x-2">
                    <span class="text-xs text-slate-400 uppercase tracking-wider">Модуль:</span>
                    <span id="level-display" class="font-bold text-cyan-400 text-sm">1/4</span>
                </div>

                <button id="sound-toggle" onclick="toggleAudio()" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 p-2 rounded-xl transition">
                    <svg id="sound-icon-on" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                    <svg id="sound-icon-off" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-5xl w-full mx-auto p-4 flex flex-col justify-center">

        <!-- Welcome Screen -->
        <section id="screen-welcome" class="vector-card rounded-3xl p-6 sm:p-10 text-center max-w-2xl mx-auto my-auto shadow-2xl relative overflow-hidden">
            <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -left-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-tr from-cyan-500 via-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center p-0.5 shadow-xl shadow-cyan-500/20 animate-float">
                <div class="w-full h-full bg-slate-900 rounded-[14px] flex items-center justify-center">
                    <svg class="w-10 h-10 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
            </div>

            <h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-3">
                Інформатика: Пошук & ШІ
            </h2>
            <p class="text-slate-300 text-sm sm:text-base mb-6 leading-relaxed">
                Ласкаво просимо до віртуальної інтерактивної лабораторії! Перевірте свої навички роботи з пошуковими операторами, критичного аналізу джерел, технологіями штучного інтелекту та створіть ефективні промпти для ChatGPT.
            </p>

            <div class="grid grid-cols-2 gap-3 mb-8 text-xs sm:text-sm text-left">
                <div class="bg-slate-800/80 p-3 rounded-xl border border-slate-700/60 flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                    <span>1. Конструктор Пошуку</span>
                </div>
                <div class="bg-slate-800/80 p-3 rounded-xl border border-slate-700/60 flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <span>2. Детектор Достовірності</span>
                </div>
                <div class="bg-slate-800/80 p-3 rounded-xl border border-slate-700/60 flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span>3. Ядро Генеративного ШІ</span>
                </div>
                <div class="bg-slate-800/80 p-3 rounded-xl border border-slate-700/60 flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                    <span>4. Майстерня Промптів</span>
                </div>
            </div>

            <button onclick="startGame()" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-lg rounded-2xl vector-btn shadow-lg shadow-cyan-500/25 flex items-center justify-center space-x-2 mx-auto">
                <span>Розпочати Дослідження</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
        </section>

        <section id="screen-game-1" class="hidden flex-col space-y-4 my-auto">
            <div class="vector-card rounded-2xl p-4 sm:p-6">
                <div class="flex items-center justify-between mb-3 border-b border-slate-700/80 pb-3">
                    <div class="flex items-center space-x-3">
                        <div class="p-2 bg-cyan-500/20 text-cyan-400 rounded-xl">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </div>
                        <div>
                            <h3 class="text-base sm:text-lg font-bold text-white">Міні-Гра 1: Лабораторія Пошукових Операторів</h3>
                            <p class="text-xs text-slate-400">Зберіть правильну термінальну команду пошуку для відсіювання "інформаційного шуму".</p>
                        </div>
                    </div>
                    <span class="text-xs font-mono bg-cyan-950 text-cyan-400 border border-cyan-800 px-2.5 py-1 rounded-lg" id="g1-step-badge">Завдання 1/3</span>
                </div>

                <!-- Mission Description Box -->
                <div class="bg-slate-900/90 rounded-xl p-4 border border-cyan-500/30 mb-4">
                    <div class="text-xs text-cyan-400 font-semibold mb-1 uppercase tracking-wider">Ціль Пошуку:</div>
                    <p id="g1-task-text" class="text-sm sm:text-base font-medium text-slate-100">Завантаження...</p>
                </div>

                <!-- Target Drop Slot Area -->
                <div class="mb-5">
                    <label class="block text-xs font-semibold text-slate-400 mb-2">Зона складання команди (натискайте або перетягуйте блоки):</label>
                    <div id="g1-drop-zone" class="min-h-[64px] bg-slate-950/80 border-2 border-dashed border-slate-700 rounded-2xl p-2 flex flex-wrap items-center gap-2 transition-all">
                        <span id="g1-placeholder" class="text-xs text-slate-500 p-2">Обирайте блоки нижче для формування запиту...</span>
                    </div>
                </div>

                <!-- Available Shuffled Option Blocks -->
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-2">Доступні блоки операторів (переплутано):</label>
                    <div id="g1-blocks-pool" class="flex flex-wrap gap-2 p-3 bg-slate-800/50 rounded-2xl border border-slate-700/50 min-h-[70px]">
                        <!-- Blocks injected dynamically -->
                    </div>
                </div>

                <div class="flex items-center justify-between mt-6 pt-4 border-t border-slate-700/60">
                    <button onclick="resetG1Query()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs sm:text-sm font-semibold rounded-xl border border-slate-700 transition">
                        Очистити
                    </button>
                    <button onclick="checkG1Query()" class="px-6 py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-sm rounded-xl vector-btn shadow-lg shadow-cyan-500/20">
                        Запустити Пошук
                    </button>
                </div>
            </div>
        </section>

        <section id="screen-game-2" class="hidden flex-col space-y-4 my-auto">
            <div class="vector-card rounded-2xl p-4 sm:p-6">
                <div class="flex items-center justify-between mb-3 border-b border-slate-700/80 pb-3">
                    <div class="flex items-center space-x-3">
                        <div class="p-2 bg-amber-500/20 text-amber-400 rounded-xl">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        </div>
                        <div>
                            <h3 class="text-base sm:text-lg font-bold text-white">Міні-Гра 2: Сканер Достовірності Джерел</h3>
                            <p class="text-xs text-slate-400">Оцініть кадри новин за критеріями інформаційної культури (Автор, Актуальність, Мета).</p>
                        </div>
                    </div>
                    <span class="text-xs font-mono bg-amber-950 text-amber-400 border border-amber-800 px-2.5 py-1 rounded-lg" id="g2-step-badge">1/4</span>
                </div>

                <!-- Interactive News Card Viewer -->
                <div class="max-w-md mx-auto w-full my-4">
                    <div id="g2-card-display" class="bg-slate-900 border-2 border-amber-500/40 rounded-2xl p-5 shadow-xl relative overflow-hidden transition-all duration-300">
                        <div class="flex items-center justify-between text-xs text-amber-400 font-bold uppercase tracking-wider mb-2">
                            <span id="g2-card-category">Джерело Новин</span>
                            <span id="g2-card-date" class="text-slate-400 font-mono">11.09.2026</span>
                        </div>
                        <h4 id="g2-card-headline" class="text-base sm:text-lg font-bold text-white mb-2 leading-snug">Завантаження картки...</h4>
                        <div class="bg-slate-800/90 rounded-xl p-3 border border-slate-700/60 mb-4 text-xs space-y-1.5 text-slate-300">
                            <div><strong class="text-slate-400">Автор:</strong> <span id="g2-card-author" class="text-white">...</span></div>
                            <div><strong class="text-slate-400">Контекст/Джерело:</strong> <span id="g2-card-context" class="text-white">...</span></div>
                        </div>

                        <!-- Tactical Choice Buttons -->
                        <div class="grid grid-cols-2 gap-3 pt-2">
                            <button onclick="sortG2Card(false)" class="p-3 bg-red-500/15 hover:bg-red-500/25 border border-red-500/40 text-red-300 font-bold rounded-xl vector-btn flex flex-col items-center justify-center space-y-1">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                <span class="text-xs">ФЕЙК / РЕКЛАМА</span>
                            </button>
                            <button onclick="sortG2Card(true)" class="p-3 bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/40 text-emerald-300 font-bold rounded-xl vector-btn flex flex-col items-center justify-center space-y-1">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span class="text-xs">ДОСТОВІРНО</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="screen-game-3" class="hidden flex-col space-y-4 my-auto">
            <div class="vector-card rounded-2xl p-4 sm:p-6">
                <div class="flex items-center justify-between mb-3 border-b border-slate-700/80 pb-3">
                    <div class="flex items-center space-x-3">
                        <div class="p-2 bg-emerald-500/20 text-emerald-400 rounded-xl">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 01-2 2h-0a2 2 0 01-2-2v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                        </div>
                        <div>
                            <h3 class="text-base sm:text-lg font-bold text-white">Міні-Гра 3: Класифікатор Завдань ШІ</h3>
                            <p class="text-xs text-slate-400">Розподіліть завдання між Традиційним Пошуковиком, Генеративним ШІ (ChatGPT) та Людською Суперсилою.</p>
                        </div>
                    </div>
                    <span class="text-xs font-mono bg-emerald-950 text-emerald-400 border border-emerald-800 px-2.5 py-1 rounded-lg" id="g3-step-badge">1/5</span>
                </div>

                <!-- Current Task Tile -->
                <div class="my-4">
                    <div class="bg-slate-900 border-2 border-emerald-500/30 rounded-2xl p-4 text-center">
                        <span class="text-xs uppercase text-slate-400 font-bold block mb-1">Вхідне Завдання:</span>
                        <div id="g3-task-box" class="text-base sm:text-lg font-extrabold text-emerald-300">
                            Завантаження...
                        </div>
                    </div>
                </div>

                <!-- 3 Target Cores -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <button onclick="sortG3Task('search')" class="p-4 bg-slate-800/90 hover:bg-slate-800 border-2 border-cyan-500/40 rounded-2xl vector-btn text-left flex flex-col justify-between space-y-2">
                        <div class="w-8 h-8 rounded-lg bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold">1</div>
                        <div>
                            <h4 class="font-bold text-white text-sm">Традиційний Пошук</h4>
                            <p class="text-[11px] text-slate-400">Шукає і показує готову наявну інформацію</p>
                        </div>
                    </button>

                    <button onclick="sortG3Task('genai')" class="p-4 bg-slate-800/90 hover:bg-slate-800 border-2 border-emerald-500/40 rounded-2xl vector-btn text-left flex flex-col justify-between space-y-2">
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">2</div>
                        <div>
                            <h4 class="font-bold text-white text-sm">Генеративний ШІ</h4>
                            <p class="text-[11px] text-slate-400">Генерує новий текст, коди, ідеї чи переклади</p>
                        </div>
                    </button>

                    <button onclick="sortG3Task('human')" class="p-4 bg-slate-800/90 hover:bg-slate-800 border-2 border-purple-500/40 rounded-2xl vector-btn text-left flex flex-col justify-between space-y-2">
                        <div class="w-8 h-8 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold">3</div>
                        <div>
                            <h4 class="font-bold text-white text-sm">Людина (Суперсила)</h4>
                            <p class="text-[11px] text-slate-400">Критична перевірка, креативне оцінювання та етика</p>
                        </div>
                    </button>
                </div>
            </div>
        </section>

        <section id="screen-game-4" class="hidden flex-col space-y-4 my-auto">
            <div class="vector-card rounded-2xl p-4 sm:p-6">
                <div class="flex items-center justify-between mb-3 border-b border-slate-700/80 pb-3">
                    <div class="flex items-center space-x-3">
                        <div class="p-2 bg-purple-500/20 text-purple-400 rounded-xl">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        </div>
                        <div>
                            <h3 class="text-base sm:text-lg font-bold text-white">Міні-Гра 4: Інженерія Промптів для ChatGPT</h3>
                            <p class="text-xs text-slate-400">Виправте слабкий промпт, додавши необхідні модулі: Конкретність, Контекст та Уточнення.</p>
                        </div>
                    </div>
                    <span class="text-xs font-mono bg-purple-950 text-purple-400 border border-purple-800 px-2.5 py-1 rounded-lg" id="g4-step-badge">1/3</span>
                </div>

                <!-- Weak Prompt Base Box -->
                <div class="bg-slate-900 border border-red-500/40 rounded-xl p-4 mb-4">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs uppercase text-red-400 font-bold">Слабкий (нерозпланований) запит:</span>
                        <span class="text-[10px] bg-red-500/20 text-red-300 px-2 py-0.5 rounded">Потребує покращення</span>
                    </div>
                    <p id="g4-weak-prompt" class="text-sm font-semibold text-slate-200">"Напиши про історію"</p>
                </div>

                <!-- Modular Workbench Selector -->
                <div class="space-y-3 mb-5">
                    <label class="block text-xs font-semibold text-slate-400">Оберіть НАЙКРАЩИЙ покращений промпт із заданим контекстом та конкретикою:</label>
                    <div id="g4-options-container" class="space-y-2">
                        <!-- Options injected dynamically -->
                    </div>
                </div>
            </div>
        </section>

        <section id="screen-results" class="hidden vector-card rounded-3xl p-6 sm:p-10 text-center max-w-2xl mx-auto my-auto shadow-2xl relative overflow-hidden">
            <div class="w-24 h-24 mx-auto mb-4 bg-gradient-to-tr from-amber-400 via-orange-500 to-yellow-300 rounded-full flex items-center justify-center p-1 shadow-2xl shadow-amber-500/30">
                <div class="w-full h-full bg-slate-900 rounded-full flex items-center justify-center">
                    <svg class="w-12 h-12 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l1.954-1.24a1 1 0 011.092.032l1.954 1.241V3a1 1 0 112 0v5a1 1 0 01-.39.782l-3.5 2.5a1 1 0 01-1.22 0l-3.5-2.5A1 1 0 019 8V3a1 1 0 011-1zm0 10a1 1 0 011 1v.01a1 1 0 11-2 0V13a1 1 0 011-1z" clip-rule="evenodd"/>
                        <path d="M6.293 9.293a1 1 0 011.414 0L10 11.586l2.293-2.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"/>
                    </svg>
                </div>
            </div>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-2">Лабораторію Пройдено!</h2>
            <p class="text-slate-300 text-sm mb-6">Ви успішно засвоїли практичні навички роботи з Інтернетом та ШІ.</p>

            <div class="bg-slate-900/90 rounded-2xl p-4 border border-slate-700/80 mb-6 text-left space-y-2">
                <div class="flex justify-between items-center text-sm">
                    <span class="text-slate-400">Загальний результат:</span>
                    <span id="res-score" class="font-extrabold text-amber-400 text-lg">0 / 100</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                    <span class="text-slate-400">Оцінка знань:</span>
                    <span id="res-grade" class="font-bold text-cyan-400">Відмінно</span>
                </div>
                <div class="w-full bg-slate-800 rounded-full h-2.5 overflow-hidden">
                    <div id="res-progress-bar" class="bg-gradient-to-r from-cyan-400 to-emerald-400 h-2.5 rounded-full" style="width: 0%"></div>
                </div>
            </div>

            <button onclick="startGame()" class="px-8 py-3.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold rounded-2xl vector-btn shadow-lg shadow-cyan-500/25">
                Пройти Знову (Змішати Завдання)
            </button>
        </section>

    </main>

    <!-- Custom Modal Message Box (No browser alert) -->
    <div id="game-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="vector-card rounded-2xl max-w-sm w-full p-6 text-center space-y-4 border-2 border-slate-700">
            <div id="modal-icon" class="w-12 h-12 mx-auto rounded-full flex items-center justify-center text-2xl">
                💡
            </div>
            <h3 id="modal-title" class="text-lg font-bold text-white">Повідомлення</h3>
            <p id="modal-body" class="text-sm text-slate-300 leading-relaxed">Деталі...</p>
            <button onclick="closeModal()" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold rounded-xl border border-slate-600 transition">
                Зрозуміло
            </button>
        </div>
    </div>

    <script>
        /* Web Audio API Sound Synthesizer */
        let audioCtx = null;
        let soundEnabled = true;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playSound(type) {
            if (!soundEnabled) return;
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;

                if (type === 'click') {
                    osc.frequency.setValueAtTime(400, now);
                    osc.frequency.exponentialRampToValueAtTime(800, now + 0.05);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                } else if (type === 'correct') {
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.setValueAtTime(659.25, now + 0.08); // E5
                    osc.frequency.setValueAtTime(783.99, now + 0.16); // G5
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'wrong') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.setValueAtTime(160, now + 0.1);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                }
            } catch (e) {}
        }

        function toggleAudio() {
            soundEnabled = !soundEnabled;
            document.getElementById('sound-icon-on').classList.toggle('hidden', !soundEnabled);
            document.getElementById('sound-icon-off').classList.toggle('hidden', soundEnabled);
        }

        /* Shuffle Utility */
        function shuffleArray(arr) {
            const array = [...arr];
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        /* Global Game State */
        let gameState = {
            score: 0,
            currentModule: 1,
            g1Step: 0,
            g2Step: 0,
            g3Step: 0,
            g4Step: 0
        };

        /* Data - Game 1: Search Operators */
        const g1Tasks = [
            {
                task: "Знайдіть точну фразу про український борщ без змін слів.",
                correct: ["\"рецепт", "українського", "борщу\""],
                distractors: ["site:wiki.org", "-м'ясо", "filetype:pdf"]
            },
            {
                task: "Знайдіть іграшкову машину, але БЕЗ згадки словосполучень про реальні машини (виключити слово).",
                correct: ["машина", "-іграшка"],
                distractors: ["* борщ", "site:gov.ua", "\"купити\""]
            },
            {
                task: "Шукайте підручники з інформатики виключно у форматі PDF на сайті підручників.",
                correct: ["інформатика", "site:infostudy.org", "filetype:pdf"],
                distractors: ["-підручник", "\"як борщ\"", "*"]
            }
        ];

        /* Data - Game 2: Information Culture / Source Verification */
        const g2CardsData = [
            {
                headline: "СЕНСАЦІЯ! Усі школи переходять на 100% віртуальне навчання вже завтра!",
                author: "Анонімний користувач у соцмережі",
                context: "Рекламний банер на сумнівному сайті без посилань на МОН",
                isReliable: false,
                reason: "Відсутній офіційний автор-експерт та присутня ознака фейкового/рекламного заголовку."
            },
            {
                headline: "Офіційні матеріали з інформатики: Пошукові оператори та ШІ для 7 класу",
                author: "Вчитель інформатики / Освітній портал",
                context: "Навчальний сайт з актуальною датою та зрозумілою освітньою метою",
                isReliable: true,
                reason: "Експертний автор, актуальна дата та чітка навчальна мета без прихованої реклами."
            },
            {
                headline: "Штучний інтелект замінить усіх людей за 2 дні: Купуйте наші курси зі знижкою 99%!",
                author: "Маркетингова компанія",
                context: "Рекламна стаття із закликом терміново витратити гроші",
                isReliable: false,
                reason: "Маніпуляція, рекламна мета, відсутність наукової достовірності."
            },
            {
                headline: "Аналітичний звіт: Принципи роботи генеративного ШІ та ChatGPT",
                author: "Дослідники технологій ШІ",
                context: "Опубліковано у науково-популярному виданні 2026 року",
                isReliable: true,
                reason: "Компетентні автори, актуальні дані 2026 року та наукова мета."
            }
        ];

        /* Data - Game 3: Generative AI & Task Sorter */
        const g3TasksData = [
            { text: "Знайти точну адресу та графік роботи міської бібліотеки", type: "search" },
            { text: "Написати творчу казку про пригоди робота-дослідника", type: "genai" },
            { text: "Критично оцінити морально-етичний аспект використання ШІ в школі", type: "human" },
            { text: "Згенерувати варіанти кольорової гами та опису для нового логотипу", type: "genai" },
            { text: "Знайти залізничні квитки на конкретну дату через офіційний сайт", type: "search" }
        ];

        /* Data - Game 4: Prompt Engineering Workshop */
        const g4PromptsData = [
            {
                weak: "«Напиши про історію»",
                options: [
                    { text: "«Розкажи про історію Київської Русі у 9-10 століттях.»", correct: true, reason: "Задано конкретні часові та географічні рамки." },
                    { text: "«Що таке історія?»", correct: false },
                    { text: "«Напиши будь-що про давні часи.»", correct: false }
                ]
            },
            {
                weak: "«Напиши твір про осінь»",
                options: [
                    { text: "«Напиши короткий твір-опис на тему \"Осінній ліс\", використовуючи чітко 5 речень.»", correct: true, reason: "Чітко визначено тему, жанр та обсяг." },
                    { text: "«Розкажи розлого все про осінь та погоду.»", correct: false },
                    { text: "«Осінь це добре чи погано?»", correct: false }
                ]
            },
            {
                weak: "«Поясни як працює ШІ»",
                options: [
                    { text: "«Це занадто складно, спробуй пояснити принципи ШІ простіше, як для учня 7 класу.»", correct: true, reason: "Задано уточнення та рівень аудиторії." },
                    { text: "«Надай мені повну наукову монографію з формулами.»", correct: false },
                    { text: "«ШІ це штучний інтелект.»", correct: false }
                ]
            }
        ];

        /* Modal Logic */
        function showModal(title, text, icon = '💡') {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-body').innerText = text;
            document.getElementById('modal-icon').innerText = icon;
            document.getElementById('game-modal').classList.remove('hidden');
        }

        function closeModal() {
            playSound('click');
            document.getElementById('game-modal').classList.add('hidden');
        }

        /* Screen Switcher */
        function showScreen(screenId) {
            ['screen-welcome', 'screen-game-1', 'screen-game-2', 'screen-game-3', 'screen-game-4', 'screen-results'].forEach(id => {
                const el = document.getElementById(id);
                if (id === screenId) {
                    el.classList.remove('hidden');
                    el.classList.add('flex');
                } else {
                    el.classList.add('hidden');
                    el.classList.remove('flex');
                }
            });
        }

        /* Start / Restart Game */
        function startGame() {
            playSound('click');
            gameState.score = 0;
            gameState.currentModule = 1;
            gameState.g1Step = 0;
            gameState.g2Step = 0;
            gameState.g3Step = 0;
            gameState.g4Step = 0;
            
            updateHeaderStats();
            showScreen('screen-game-1');
            initG1Step();
        }

        function updateHeaderStats() {
            document.getElementById('score-display').innerText = gameState.score;
            document.getElementById('level-display').innerText = `${gameState.currentModule}/4`;
        }

        let g1SelectedBlocks = [];

        function initG1Step() {
            if (gameState.g1Step >= g1Tasks.length) {
                gameState.currentModule = 2;
                updateHeaderStats();
                showScreen('screen-game-2');
                initG2Step();
                return;
            }

            document.getElementById('g1-step-badge').innerText = `Завдання ${gameState.g1Step + 1}/${g1Tasks.length}`;
            const currentData = g1Tasks[gameState.g1Step];
            document.getElementById('g1-task-text').innerText = currentData.task;

            g1SelectedBlocks = [];
            renderG1Selected();

            // Shuffle option blocks (correct + distractors)
            const allBlocks = shuffleArray([...currentData.correct, ...currentData.distractors]);
            const poolContainer = document.getElementById('g1-blocks-pool');
            poolContainer.innerHTML = '';

            allBlocks.forEach(text => {
                const btn = document.createElement('button');
                btn.className = "px-3 py-2 bg-slate-700 hover:bg-slate-600 text-cyan-300 font-mono text-xs sm:text-sm rounded-xl border border-slate-600 vector-btn transition drag-item";
                btn.innerText = text;
                btn.onclick = () => selectG1Block(text, btn);
                poolContainer.appendChild(btn);
            });
        }

        function selectG1Block(text, btnEl) {
            playSound('click');
            g1SelectedBlocks.push(text);
            btnEl.disabled = true;
            btnEl.classList.add('opacity-30', 'pointer-events-none');
            renderG1Selected();
        }

        function renderG1Selected() {
            const dropZone = document.getElementById('g1-drop-zone');
            dropZone.innerHTML = '';

            if (g1SelectedBlocks.length === 0) {
                dropZone.innerHTML = '<span id="g1-placeholder" class="text-xs text-slate-500 p-2">Обирайте блоки нижче для формування запиту...</span>';
                return;
            }

            g1SelectedBlocks.forEach((text, idx) => {
                const tag = document.createElement('span');
                tag.className = "px-3 py-1.5 bg-cyan-900/90 text-cyan-200 border border-cyan-500/50 font-mono text-xs sm:text-sm rounded-lg flex items-center space-x-1";
                tag.innerText = text;
                dropZone.appendChild(tag);
            });
        }

        function resetG1Query() {
            playSound('click');
            g1SelectedBlocks = [];
            initG1Step();
        }

        function checkG1Query() {
            const currentData = g1Tasks[gameState.g1Step];
            const isCorrect = JSON.stringify(g1SelectedBlocks) === JSON.stringify(currentData.correct);

            if (isCorrect) {
                playSound('correct');
                gameState.score += 25;
                updateHeaderStats();
                showModal("Чудово!", "Правильна комбінація операторів! Інформаційний шум відсіяно.", "🎯");
                gameState.g1Step++;
                setTimeout(initG1Step, 500);
            } else {
                playSound('wrong');
                showModal("Помилка Пошуку", "Спробуйте ще раз! Зверніть увагу на точність лапок, знаків мінус чи розширень файлів.", "❌");
            }
        }

        let shuffledG2Data = [];

        function initG2Step() {
            if (gameState.g2Step === 0) {
                shuffledG2Data = shuffleArray(g2CardsData);
            }

            if (gameState.g2Step >= shuffledG2Data.length) {
                gameState.currentModule = 3;
                updateHeaderStats();
                showScreen('screen-game-3');
                initG3Step();
                return;
            }

            document.getElementById('g2-step-badge').innerText = `${gameState.g2Step + 1}/${shuffledG2Data.length}`;
            const card = shuffledG2Data[gameState.g2Step];

            document.getElementById('g2-card-headline').innerText = card.headline;
            document.getElementById('g2-card-author').innerText = card.author;
            document.getElementById('g2-card-context').innerText = card.context;
        }

        function sortG2Card(userChoice) {
            const card = shuffledG2Data[gameState.g2Step];
            if (userChoice === card.isReliable) {
                playSound('correct');
                gameState.score += 20;
                updateHeaderStats();
                showModal("Правильний Аналіз!", card.reason, "✅");
            } else {
                playSound('wrong');
                showModal("Помилка Оцінки!", `Невірно. ${card.reason}`, "⚠️");
            }

            gameState.g2Step++;
            setTimeout(initG2Step, 300);
        }

        let shuffledG3Data = [];

        function initG3Step() {
            if (gameState.g3Step === 0) {
                shuffledG3Data = shuffleArray(g3TasksData);
            }

            if (gameState.g3Step >= shuffledG3Data.length) {
                gameState.currentModule = 4;
                updateHeaderStats();
                showScreen('screen-game-4');
                initG4Step();
                return;
            }

            document.getElementById('g3-step-badge').innerText = `${gameState.g3Step + 1}/${shuffledG3Data.length}`;
            const task = shuffledG3Data[gameState.g3Step];
            document.getElementById('g3-task-box').innerText = task.text;
        }

        function sortG3Task(chosenType) {
            const task = shuffledG3Data[gameState.g3Step];
            if (chosenType === task.type) {
                playSound('correct');
                gameState.score += 15;
                updateHeaderStats();
                showModal("Вірно!", "Ви правильно визначили призначення та тип технології для цього завдання.", "⚡");
            } else {
                playSound('wrong');
                showModal("Не зовсім так", "Пам'ятайте: Традиційний пошук знаходить наявне, Генеративний ШІ створює нове, а Людина відповідає за критичне мислення та етику.", "🤔");
            }

            gameState.g3Step++;
            setTimeout(initG3Step, 300);
        }

        let shuffledG4Data = [];

        function initG4Step() {
            if (gameState.g4Step === 0) {
                shuffledG4Data = shuffleArray(g4PromptsData);
            }

            if (gameState.g4Step >= shuffledG4Data.length) {
                showResultsScreen();
                return;
            }

            document.getElementById('g4-step-badge').innerText = `${gameState.g4Step + 1}/${shuffledG4Data.length}`;
            const item = shuffledG4Data[gameState.g4Step];
            document.getElementById('g4-weak-prompt').innerText = item.weak;

            const container = document.getElementById('g4-options-container');
            container.innerHTML = '';

            // Shuffle options
            const shuffledOptions = shuffleArray(item.options);

            shuffledOptions.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "w-full p-3.5 bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-purple-500/50 rounded-xl text-left font-medium text-xs sm:text-sm text-slate-100 vector-btn flex items-center justify-between";
                btn.innerHTML = `<span>${opt.text}</span>`;
                btn.onclick = () => selectG4Option(opt);
                container.appendChild(btn);
            });
        }

        function selectG4Option(option) {
            if (option.correct) {
                playSound('correct');
                gameState.score += 25;
                updateHeaderStats();
                showModal("Відмінний Промпт!", option.reason, "🚀");
            } else {
                playSound('wrong');
                showModal("Слабкий Запит", "Цей варіант залишається занадто загальним або не дає потрібного контексту.", "❌");
            }

            gameState.g4Step++;
            setTimeout(initG4Step, 300);
        }

        function showResultsScreen() {
            showScreen('screen-results');
            playSound('correct');

            const scoreDisplay = document.getElementById('res-score');
            const gradeDisplay = document.getElementById('res-grade');
            const bar = document.getElementById('res-progress-bar');

            scoreDisplay.innerText = `${gameState.score} Балів`;

            let grade = "Початковий рівень";
            let color = "text-amber-400";

            if (gameState.score >= 180) {
                grade = "Експерт з Пошуку та ШІ (12 балів)";
                color = "text-emerald-400";
            } else if (gameState.score >= 130) {
                grade = "Дослідник Інфо-простору (9-11 балів)";
                color = "text-cyan-400";
            } else {
                grade = "Учень-початківець (Рекомендовано повторити)";
                color = "text-amber-400";
            }

            gradeDisplay.innerText = grade;
            gradeDisplay.className = `font-bold ${color}`;

            const percent = Math.min(100, Math.round((gameState.score / 230) * 100));
            bar.style.width = `${percent}%`;
        }
    </script>
</body>
</html>
